@nrsdev_langapp_api_HostAddress = http://localhost:5030

GET {{nrsdev_langapp_api_HostAddress}}/api/questions/jp
Accept: application/json

###

POST {{nrsdev_langapp_api_HostAddress}}/api/results
Content-Type: application/json

{
    "TargetLanguage": "JP",
    "NativeLanguage": "EN",
    "Results": [
        {
            "Question": "What is 'hello' in Japanese?",
            "CorrectAnswer": "こんにちは",
            "GivenAnswer": "こんにちわ"
        }
    ]
}